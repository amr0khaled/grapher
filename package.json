{
  "name": "grapher",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "bun build:rs:release && vite build",
    "build:rs:release": "bash -c \"cd engine && wasm-pack build --release --target web --out-dir ../src/wasm\"",
    "build:rs": "bash -c \"cd engine && wasm-pack build --debug --target web --out-dir ../src/wasm\"",
    "preview": "vite preview",
    "check": "svelte-check"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.9",
    "@typescript/native": "npm:typescript@7",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "~6",
    "vite": "^8.3.8",
    "vite-plugin-wasm-pack": "^0.1.12",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@types/katex": "^0.16.8",
    "katex": "^0.19.1",
    "mathlive": "^0.111.4"
  }
}
